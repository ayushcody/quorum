{
  "permissions": {
    "allow": [
      "Edit(web/**)",
      "Edit(src/agents/**)"
    ],
    "ask": [
      "Edit(src/policy/**)",
      "Edit(src/settlement/**)",
      "Edit(src/paypal/**)",
      "Edit(src/db/migrations/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.sh",
            "timeout": 90,
            "statusMessage": "pnpm typecheck"
          }
        ]
      }
    ]
  }
}
