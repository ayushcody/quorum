# Sandbox only. Copy to .env and fill in; see scripts/sandbox-accounts.md.

# Coordinator (quorum-web / quorum-worker)
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Supplier process (separate env in production; here only for the R1 spike)
SUPPLIER_MERCHANT_ID=
SUPPLIER_PAYPAL_CLIENT_ID=
SUPPLIER_PAYPAL_CLIENT_SECRET=

# PayPal sandbox card generator output (test values only; demo-mode bot members, DECISIONS D4).
# Expiry may be MM/YYYY as the generator shows it, or YYYY-MM.
SANDBOX_CARD_NUMBER=
SANDBOX_CARD_EXPIRY=
SANDBOX_CARD_CVV=

# Spike 1 (scripts/spike-authorize.ts): the supplier sandbox business account email (PAYEE_MODE=direct only)
SUPPLIER_SANDBOX_EMAIL=

# AG Studio licence key (browser-side: VITE_ vars are bundled into JS; never put other secrets under VITE_).
# Bryntum has no runtime key: trial vs licensed is the npm package (DECISIONS D5).
VITE_AG_STUDIO_LICENSE_KEY=

# direct | coop_merchant (default; see docs/DECISIONS.md)
PAYEE_MODE=coop_merchant
