# Sandbox only. Copy to .env and fill in; see scripts/sandbox-accounts.md.
# Every key the code reads is listed here (test/env-docs.test.ts enforces it). Never commit values.
# "where" = which process reads it: web (quorum-web), worker (quorum-worker), build (vite build), spike (scripts/tests only).

# --- PayPal (web, worker) -----------------------------------------------------------
# Must be exactly "sandbox"; any other value refuses to boot.
PAYPAL_ENV=sandbox
# Optional; must be the sandbox host if set.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Co-op app (developer.paypal.com → Apps & Credentials → your Merchant app). Secret: Render "sync: false".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# web. Webhook ID from the PayPal dashboard, created after the first deploy (it needs the Render URL).
# Until set, POST /webhooks/paypal answers 503 so PayPal retries.
PAYPAL_WEBHOOK_ID=

# --- Runtime (web, worker) ----------------------------------------------------------
# web. Render sets it; local default 3000.
PORT=3000
# web, worker. On Render this comes from the quorum-db database. Optional locally: /health reports "unconfigured".
DATABASE_URL=

# --- Frontend (build) ---------------------------------------------------------------
# AG Studio licence key, read at `vite build` time and bundled into browser JS (meant to ship client-side).
# Never put any other secret under a VITE_ name. Bryntum has no runtime key (DECISIONS D5).
VITE_AG_STUDIO_LICENSE_KEY=

# --- Spikes and sandbox tests only (spike) ------------------------------------------
# direct | coop_merchant (default; DECISIONS D1). Production code supports coop_merchant only.
PAYEE_MODE=coop_merchant
# Supplier sandbox business account (R1 spike; later the payout receiver, S2.9).
SUPPLIER_SANDBOX_EMAIL=
SUPPLIER_MERCHANT_ID=
SUPPLIER_PAYPAL_CLIENT_ID=
SUPPLIER_PAYPAL_CLIENT_SECRET=
# PayPal sandbox card generator output (test values only; demo-mode bot members, DECISIONS D4).
# Expiry may be MM/YYYY as the generator shows it, or YYYY-MM.
SANDBOX_CARD_NUMBER=
SANDBOX_CARD_EXPIRY=
SANDBOX_CARD_CVV=
